                                app:layout_constraintStart_toStartOf="@+id/tvedit_order"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:background="@drawable/dash_rectangle"/>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/mcv_logout"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_48sdp"
                                app:cardBackgroundColor="@color/transparent"
                                app:strokeWidth="0dp"
                                android:elevation="0dp"
                                app:cardElevation="0dp"
                                app:cardCornerRadius="0dp">
                                <LinearLayout
                                    android:id="@+id/btn_logout"
                                    android:background="@drawable/bg_rectangular_transparent"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">
                                    <ImageView
                                        android:layout_width="@dimen/_32sdp"
                                        android:layout_height="@dimen/_32sdp"
                                        android:src="@drawable/ic_manage_accounr"
                                        app:tint="@color/red_logout"
                                        android:layout_marginStart="@dimen/_10sdp" />

                                    <TextView
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="@dimen/_12sdp"
                                        android:layout_marginEnd="@dimen/_15ssp"
                                        android:text="Log out"
                                        android:textColor="@color/red_logout"
                                        android:fontFamily="@font/helvetica"
                                        android:textSize="@dimen/_13ssp"
                                        android:gravity="center_vertical"
                                        android:layout_weight="1"
                                        />

                                    <ImageView
                                        android:layout_width="@dimen/_12sdp"
                                        android:layout_height="@dimen/_12sdp"
                                        android:layout_marginRight="@dimen/_10sdp"
                                        android:src="@drawable/back"
                                        app:tint="@color/black"
                                        android:visibility="gone"
                                        />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>


                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>