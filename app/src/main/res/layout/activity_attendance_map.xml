<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.attendance.AttendanceMap"
    android:background="@color/white"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        >
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginBottom="@dimen/dp_15"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginStart="@dimen/_8sdp"
            android:backgroundTint="@color/color_primary"
            android:contentDescription="TODO"
            android:clickable="true"
            android:padding="@dimen/dp_4"
            android:src="@drawable/ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Punch Session Details"
            android:textColor="@color/color_344054"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            android:layout_marginStart="@dimen/_12sdp"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/view2"
            android:layout_width="match_parent"
            android:layout_height="0.8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@color/color_DBD7D7"
            android:visibility="gone"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/cl_toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/activity_bg">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_map"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintDimensionRatio="1:0.7"
            app:strokeWidth="0dp"
            app:cardCornerRadius="0dp">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />
        </com.google.android.material.card.MaterialCardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/mcv_map"
            app:layout_constraintBottom_toBottomOf="parent"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_20sdp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcv_trip_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="@dimen/_15sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardBackgroundColor="@color/white">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:id="@+id/tv_session_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Trip Number"
                            android:textSize="@dimen/_13ssp"
                            android:textColor="@color/color_344054"
                            android:fontFamily="@font/poppins_medium"
                            app:layout_constraintTop_toTopOf="@id/cl_trip_status"
                            app:layout_constraintBottom_toBottomOf="@id/cl_trip_status"
                            app:layout_constraintStart_toStartOf="parent"
                            />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/cl_trip_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:background="@drawable/bg_circular_light"
                            android:backgroundTint="@color/green"
                            >

                            <com.ecosphere.partner.core.widget.LiveIndicatorView
                                android:id="@+id/liveIndicator_tripStatus"
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:layout_marginStart="@dimen/_4sdp"
                                app:layout_constraintTop_toTopOf="@id/tv_trip_status"
                                app:layout_constraintBottom_toBottomOf="@id/tv_trip_status"
                                app:layout_constraintStart_toStartOf="parent"
                                app:dotColor="@color/green"
                                app:rippleColor="@color/parrotgreen"
                                app:dotRadius="3.5dp"
                                app:duration="1200"/>
                            <TextView
                                android:id="@+id/tv_trip_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginStart="@dimen/_1sdp"
                                app:layout_constraintStart_toEndOf="@id/liveIndicator_tripStatus"
                                android:layout_marginEnd="@dimen/_12sdp"
                                android:text="Running"
                                android:textSize="@dimen/_11ssp"
                                android:textColor="@color/color_primary_dark"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingTop="@dimen/_2sdp"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:layout_marginBottom="@dimen/_2sdp"
                                />
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:id="@+id/view"
                            android:layout_width="match_parent"
                            android:layout_height="0.6dp"
                            android:background="@color/color_DBD7D7"
                            app:layout_constraintTop_toBottomOf="@id/cl_trip_status"
                            android:layout_marginTop="@dimen/_10sdp"/>

                        <androidx.constraintlayout.widget.Guideline
                            android:id="@+id/guideline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:layout_constraintGuide_percent="0.5"
                            android:orientation="vertical"
                            />

                        <ImageView
                            android:id="@+id/iv_start_time"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/bg_circular_light"
                            app:tint="@color/color_primary"
                            android:backgroundTint="@color/color_primary"
                            android:src="@drawable/ic_clock"
                            android:padding="@dimen/_7sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/view"
                            android:layout_marginTop="@dimen/_13sdp"
                            />
                        <TextView
                            android:id="@+id/startime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_start_time"
                            app:layout_constraintEnd_toStartOf="@id/guideline"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toTopOf="@id/iv_start_time"
                            android:text="Start Time"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/_10ssp"
                            />
                        <TextView
                            android:id="@+id/tv_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_start_time"
                            app:layout_constraintEnd_toStartOf="@id/guideline"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toBottomOf="@id/startime"
                            android:text="- -"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_13ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:singleLine="true"
                            />

                        <ImageView
                            android:id="@+id/iv_duration"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/bg_circular_light"
                            app:tint="@color/color_primary"
                            android:backgroundTint="@color/color_primary"
                            android:src="@drawable/ic_clock"
                            android:padding="@dimen/_7sdp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_start_time"
                            android:layout_marginTop="@dimen/_15sdp"
                            />
                        <TextView
                            android:id="@+id/duration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_duration"
                            app:layout_constraintEnd_toStartOf="@id/guideline"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toTopOf="@id/iv_duration"
                            android:text="Duration"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/_10ssp"
                            />
                        <TextView
                            android:id="@+id/tv_duration"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_duration"
                            app:layout_constraintEnd_toStartOf="@id/guideline"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toBottomOf="@id/duration"
                            android:text="- -"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_13ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:singleLine="true"
                            />

                        <ImageView
                            android:id="@+id/iv_end_time"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/bg_circular_light"
                            app:tint="@color/color_primary"
                            android:backgroundTint="@color/color_primary"
                            android:src="@drawable/ic_clock"
                            android:padding="@dimen/_7sdp"
                            app:layout_constraintStart_toEndOf="@id/guideline"
                            app:layout_constraintTop_toTopOf="@id/iv_start_time"
                            android:layout_marginStart="@dimen/_5sdp"
                            />
                        <TextView
                            android:id="@+id/endtime"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_end_time"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toTopOf="@id/iv_start_time"
                            android:text="End Time"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/_10ssp"
                            />
                        <TextView
                            android:id="@+id/tv_end_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_end_time"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toBottomOf="@id/startime"
                            android:text="- -"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_13ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:singleLine="true"
                            />

                        <ImageView
                            android:id="@+id/iv_distance"
                            android:layout_width="@dimen/_30sdp"
                            android:layout_height="@dimen/_30sdp"
                            android:background="@drawable/bg_circular_light"
                            app:tint="@color/color_primary"
                            android:backgroundTint="@color/color_primary"
                            android:src="@drawable/ic_distance"
                            android:padding="@dimen/_4sdp"
                            app:layout_constraintStart_toEndOf="@id/guideline"
                            app:layout_constraintTop_toTopOf="@id/iv_duration"
                            android:layout_marginStart="@dimen/_5sdp"
                            />
                        <TextView
                            android:id="@+id/distance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_distance"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toTopOf="@id/iv_distance"
                            android:text="Distance"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/_10ssp"
                            />
                        <TextView
                            android:id="@+id/tv_distance"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:layout_constraintStart_toEndOf="@id/iv_distance"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:layout_marginStart="@dimen/_7sdp"
                            app:layout_constraintTop_toBottomOf="@id/distance"
                            android:text="- -"
                            android:textColor="@color/black"
                            android:textSize="@dimen/_13ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:singleLine="true"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="@dimen/_2sdp"
                    app:strokeWidth="0dp"
                    app:cardCornerRadius="@dimen/_15sdp"
                    app:layout_constraintTop_toBottomOf="@id/mcv_trip_details"
                    android:layout_marginStart="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_12sdp"
                    android:layout_marginTop="@dimen/_15sdp"
                    app:cardBackgroundColor="@color/white"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="@dimen/_10sdp">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="@dimen/_12sdp">

                        <TextView
                            android:id="@+id/routeDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Route Details"
                            android:textSize="@dimen/_13ssp"
                            android:textColor="@color/color_344054"
                            android:fontFamily="@font/poppins_medium"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            />

                        <View
                            android:id="@+id/view1"
                            android:layout_width="match_parent"
                            android:layout_height="0.6dp"
                            android:background="@color/color_DBD7D7"
                            app:layout_constraintTop_toBottomOf="@id/routeDetails"
                            android:layout_marginTop="@dimen/_7sdp"/>

                        <TextView
                            android:id="@+id/starAdd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/view1"
                            android:text="Start Address"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/_10ssp"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:fontFamily="@font/poppins_medium"
                            />
                        <TextView
                            android:id="@+id/tv_start_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/starAdd"
                            android:text=". . ."
                            android:textColor="@color/black"
                            android:textSize="@dimen/_11ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="@dimen/_1sdp"
                            />

                        <TextView
                            android:id="@+id/endAdd"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/tv_start_address"
                            android:text="End Address"
                            android:textColor="@color/gray_text_color"
                            android:textSize="@dimen/_10ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="@dimen/_15sdp"
                            />
                        <TextView
                            android:id="@+id/tv_end_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:layout_constraintTop_toBottomOf="@id/endAdd"
                            android:text=". . ."
                            android:textColor="@color/black"
                            android:textSize="@dimen/_11ssp"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_marginTop="@dimen/_1sdp"
                            />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>