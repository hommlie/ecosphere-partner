<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".feature.dashboard.Dashboard"
    android:background="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_session_running">

    <View
        android:id="@+id/view_status_bar"
        android:layout_width="match_parent"
        android:layout_height="0.1dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/mcv_profile"
        android:layout_width="@dimen/_40sdp"
        android:layout_height="@dimen/_40sdp"
        app:layout_constraintTop_toBottomOf="@id/view_status_bar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/_10sdp"
        app:cardBackgroundColor="@color/transparent"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:strokeWidth="0dp"
        app:cardCornerRadius="@dimen/_20sdp"
        android:elevation="0dp"
        app:cardElevation="@dimen/_2sdp"
        >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/color_primary">
        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            />
        <TextView
            android:id="@+id/tv_short_name"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="VR"
            android:gravity="center"
            android:fontFamily="@font/poppins_semibold_italic"
            android:textColor="@color/white"
            android:paddingTop="@dimen/_2sdp"
            android:textSize="@dimen/_14ssp"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/mcv_profile"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/mcv_profile"
            android:layout_marginEnd="@dimen/_12sdp"
            android:textColor="@color/gray_Text_color_dark"
            android:text="Greeting"
            android:textSize="@dimen/_11ssp"
            />
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toEndOf="@id/mcv_profile"
            android:layout_marginStart="@dimen/_10sdp"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="@dimen/_12sdp"
            android:textColor="@color/black"
            android:paddingTop="@dimen/_2sdp"
            android:text="User Name"
            android:textSize="@dimen/_14ssp"
            android:fontFamily="@font/poppins_medium"
            app:layout_constraintTop_toBottomOf="@id/tv_greeting"
            app:layout_constraintBottom_toBottomOf="@id/mcv_profile"
            />


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_toggle_card"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            app:layout_constraintTop_toBottomOf="@id/mcv_profile"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardBackgroundColor="@color/transparent"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:strokeWidth="0dp"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="@dimen/_2sdp"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_splash">

                <TextView
                    android:id="@+id/tv_post_place"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@id/dutyToggle"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textColor="@color/off_white"
                    android:singleLine="true"
                    android:paddingTop="@dimen/_2sdp"
                    android:text="Vignana Nagar · Waste &amp; Collection Partner"
                    android:textSize="@dimen/_10ssp"
                    app:layout_constraintTop_toTopOf="@id/dutyToggle"
                    app:layout_constraintBottom_toTopOf="@id/tv_duty_status"
                    />
                <TextView
                    android:id="@+id/tv_duty_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@id/dutyToggle"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textColor="@color/white"
                    android:singleLine="true"
                    android:paddingTop="@dimen/_2sdp"
                    android:text="You're Duty Status"
                    android:textSize="@dimen/_14ssp"
                    android:fontFamily="@font/poppins_semibold"
                    app:layout_constraintTop_toBottomOf="@id/tv_post_place"
                    app:layout_constraintBottom_toBottomOf="@id/dutyToggle"
                    />

                <com.ecosphere.partner.core.widget.DutyToggleView
                    android:id="@+id/dutyToggle"
                    android:layout_width="@dimen/_58sdp"
                    android:layout_height="@dimen/_30sdp"
                    app:checked="false"
                    app:onText="Duty On"
                    app:offText="Duty Off"
                    android:layout_marginEnd="@dimen/dp_15"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mcv_checked_status"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_60sdp"
            app:layout_constraintTop_toBottomOf="@id/mcv_toggle_card"
            android:layout_marginTop="@dimen/_10sdp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginEnd="@dimen/_12sdp"
            app:strokeWidth="0dp"
            app:cardCornerRadius="@dimen/_12sdp"
            app:cardElevation="@dimen/_2sdp"
            >
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mcv_speed"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="@dimen/_12sdp"
                    app:cardCornerRadius="@dimen/_20sdp"
                    app:cardBackgroundColor="@color/white"
                    app:cardElevation="@dimen/_2sdp"
                    android:elevation="0dp"
                    app:strokeWidth="0dp"
                    >
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/tv_current_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:gravity="center"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="@color/color_primary"
                            android:textSize="@dimen/_15ssp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            android:singleLine="true"
                            android:layout_marginTop="@dimen/_2sdp"
                            />
                        <TextView
                            android:id="@+id/tv_speed_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km/h"
                            android:gravity="center"
                            android:textColor="@color/color_primary"
                            android:singleLine="true"
                            android:textSize="@dimen/_10ssp"
                            android:layout_marginBottom="@dimen/_5sdp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_checkedAt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/mcv_speed"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@id/tv_shift_status"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textColor="@color/black"
                    android:singleLine="true"
                    android:text="Session Live Data"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/poppins_medium"
                    app:layout_constraintTop_toTopOf="@id/tv_shift_status"
                    app:layout_constraintBottom_toTopOf="@id/tv_total_distance"
                    />
                <TextView
                    android:id="@+id/tv_total_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/mcv_speed"
                    android:layout_marginStart="@dimen/_10sdp"
                    app:layout_constraintEnd_toStartOf="@id/tv_shift_status"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textColor="@color/gray_Text_color_dark"
                    android:singleLine="true"
                    android:text="Total Distance"
                    android:textSize="@dimen/_11ssp"
                    app:layout_constraintTop_toBottomOf="@id/tv_checkedAt"
                    app:layout_constraintBottom_toBottomOf="@id/tv_shift_status"
                    />

                <TextView
                    android:id="@+id/tv_shift_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shift"
                    android:layout_marginEnd="@dimen/dp_15"
                    android:paddingStart="@dimen/_10sdp"
                    android:paddingEnd="@dimen/_10sdp"
                    android:paddingTop="@dimen/_2sdp"
                    android:paddingBottom="@dimen/_2sdp"
                    android:textColor="@color/color_primary"
                    android:textSize="@dimen/_10ssp"
                    android:background="@drawable/circular_background"
                    android:backgroundTint="@color/color_primary_light"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/mcv_checked_status"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="@dimen/_10sdp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:weightSum="3"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcv_total_pickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        app:strokeWidth="0dp"
                        app:cardElevation="@dimen/_2sdp"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_session_running"
                            android:padding="@dimen/_8sdp">

                            <ImageView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:background="@drawable/bg_curv_light"
                                app:tint="@color/color_primary"
                                android:backgroundTint="@color/color_primary"
                                android:src="@drawable/ic_total"
                                android:padding="@dimen/_4sdp"
                                android:layout_gravity="start"
                                />

                        <TextView
                            android:id="@+id/tv_all_pickup"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/color_344054"
                            android:layout_marginTop="@dimen/_6sdp"
                            android:fontFamily="@font/sfprodisplay_bold"
                            android:singleLine="true"
                            android:textSize="@dimen/_16ssp"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Total Pickup"
                                android:textColor="@color/gray_Text_color_dark"
                                android:textSize="@dimen/_10ssp"
                                android:singleLine="true"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcv_pending_pickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        app:strokeWidth="0dp"
                        app:cardElevation="@dimen/_2sdp"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_session_running"
                            android:padding="@dimen/_8sdp">

                            <ImageView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:background="@drawable/bg_curv_light"
                                app:tint="@color/color_primary"
                                android:backgroundTint="@color/color_primary"
                                android:src="@drawable/ic_clock"
                                android:padding="@dimen/_4sdp"
                                android:layout_gravity="start"
                                />

                            <TextView
                                android:id="@+id/tv_pending_pickup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:singleLine="true"
                                android:textColor="@color/color_344054"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:fontFamily="@font/sfprodisplay_bold"
                                android:textSize="@dimen/_16ssp"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Pending Pickup"
                                android:textColor="@color/gray_Text_color_dark"
                                android:textSize="@dimen/_10ssp"
                                android:singleLine="true"/>


                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/mcv_completed_pickup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:layout_marginBottom="@dimen/_5sdp"
                        app:strokeWidth="0dp"
                        app:cardElevation="@dimen/_2sdp"
                        >
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:background="@drawable/bg_session_running"
                            android:padding="@dimen/_8sdp">

                            <ImageView
                                android:layout_width="@dimen/_20sdp"
                                android:layout_height="@dimen/_20sdp"
                                android:background="@drawable/bg_curv_light"
                                app:tint="@color/color_primary"
                                android:backgroundTint="@color/color_primary"
                                android:src="@drawable/ic_right"
                                android:padding="@dimen/_3sdp"
                                android:layout_gravity="start"
                                />

                            <TextView
                                android:id="@+id/tv_completed_pickup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/color_344054"
                                android:layout_marginTop="@dimen/_6sdp"
                                android:fontFamily="@font/sfprodisplay_bold"
                                android:singleLine="true"
                                android:textSize="@dimen/_16ssp"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Completed"
                                android:textColor="@color/gray_Text_color_dark"
                                android:textSize="@dimen/_10ssp"
                                android:singleLine="true"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>



            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>


    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>