<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/_1sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        app:strokeWidth="0dp"
        app:cardElevation="@dimen/_1sdp"
        app:cardBackgroundColor="@color/white">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_11sdp">


            <TextView
                android:id="@+id/tv_customer_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toStartOf="@id/liveIndicator"
                android:layout_marginEnd="@dimen/_10sdp"
                android:singleLine="true"
                android:text="Name"
                android:textSize="@dimen/_15ssp"
                android:textColor="@color/eco_text_primary"
                android:fontFamily="@font/poppins_semibold"
                />
            <TextView
                android:id="@+id/tv_all_pickup_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_customer_name"
                android:layout_marginEnd="@dimen/_10sdp"
                android:singleLine="true"
                android:text="PK2026 · 10:30 AM"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/eco_text_secondary"
                />

            <com.ecosphere.partner.core.widget.LiveIndicatorView
                android:id="@+id/liveIndicator"
                android:layout_width="@dimen/_15sdp"
                android:layout_height="@dimen/_15sdp"
                app:layout_constraintTop_toTopOf="@id/tv_status"
                app:layout_constraintBottom_toBottomOf="@id/tv_status"
                app:layout_constraintEnd_toStartOf="@id/tv_status"
                app:dotColor="@color/pickup_pending"
                app:rippleColor="@color/pickup_pending"
                app:dotRadius="3.5dp"
                app:duration="1200"
                />
            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:text="PENDING"
                android:textSize="@dimen/_10ssp"
                android:textColor="@color/pickup_pending"
                android:fontFamily="@font/inter_medium"
                />

            <LinearLayout
                android:id="@+id/ll1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tv_all_pickup_id"
                android:layout_marginTop="@dimen/_10sdp">

                <ImageView
                    android:id="@+id/iv_waste_type"
                    android:layout_width="@dimen/_10sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/bg_circle"
                    app:tint="@color/waste_wet"
                    android:layout_gravity="center_vertical"
                    />
                <TextView
                    android:id="@+id/tv_waste_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waste Type"
                    android:textColor="@color/waste_wet"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_gravity="center_vertical"
                    />
                <ImageView
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="@dimen/_5sdp"
                    android:src="@drawable/bg_circle"
                    app:tint="@color/light_gray"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_7sdp"
                    />
                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5 km"
                    android:textColor="@color/eco_text_secondary"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_gravity="center_vertical"
                    />
                <ImageView
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="@dimen/_5sdp"
                    android:src="@drawable/bg_circle"
                    app:tint="@color/light_gray"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="@dimen/_7sdp"
                    />
                <TextView
                    android:id="@+id/tv_weight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="~15 kg"
                    android:textColor="@color/eco_text_secondary"
                    android:textSize="@dimen/_12ssp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/_7sdp"
                    android:layout_gravity="center_vertical"
                    />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/ll2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ll1"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                >
                <ImageView
                    android:layout_width="@dimen/_15sdp"
                    android:layout_height="@dimen/_15sdp"
                    android:src="@drawable/ic_location"
                    app:tint="@color/eco_text_primary"
                    android:gravity="start|top"
                    />
                <TextView
                    android:id="@+id/tv_pickup_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="204, Palm Residency, 4th Cross, Indiranagar, Bengaluru - 560038"
                    android:textColor="@color/eco_text_primary"
                    android:textSize="@dimen/_11ssp"
                    android:fontFamily="@font/inter_medium"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_gravity="center_vertical"
                    android:lineHeight="@dimen/_18sdp"
                    />
            </LinearLayout>

            <View
                android:id="@+id/view1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                app:layout_constraintTop_toBottomOf="@id/ll2"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@color/eco_divider"
                />

            <LinearLayout
                android:id="@+id/cl2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_34sdp"
                app:layout_constraintTop_toBottomOf="@id/view1"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginBottom="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_11sdp"
                android:weightSum="3"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/ll_call"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/bk_call">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:src="@drawable/ic_call"
                        android:layout_marginEnd="@dimen/_1sdp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#344054"
                        android:text="Call"
                        android:textAlignment="viewStart"
                        android:textSize="@dimen/_11sdp"
                        android:layout_marginEnd="@dimen/_4sdp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_map"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/bk_call">

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_navigation"
                        android:layout_marginEnd="@dimen/_1sdp"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#344054"
                        android:text="Direction"
                        android:textAlignment="viewStart"
                        android:textSize="@dimen/_11sdp"
                        android:layout_marginEnd="@dimen/_3sdp"/>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_start"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gradient_curved_btn"
                    >

                    <ImageView
                        android:layout_width="25dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_book"
                        android:layout_marginEnd="@dimen/_1sdp"
                        app:tint="@color/white"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:text="PickUp"
                        android:textAlignment="viewStart"
                        android:textSize="@dimen/_11sdp"
                        android:layout_marginStart="@dimen/_2sdp"
                        android:fontFamily="@font/inter_medium"
                        android:layout_marginEnd="@dimen/_1sdp"/>

                </LinearLayout>
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>