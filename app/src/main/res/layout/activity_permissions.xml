<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".feature.permissions.ui.PermissionsAct"
    android:background="@color/surface">

    <!-- Content column: capped max width, centered horizontally so it stays -->
    <!-- comfortable on tablets/foldables instead of stretching edge-to-edge -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contentColumn"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintWidth_max="@dimen/onboarding_content_max_width"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Progress dots -->
        <LinearLayout
            android:id="@+id/dotsContainer"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="@dimen/onboarding_horizontal_margin"
            android:layout_marginEnd="@dimen/onboarding_horizontal_margin" />

        <!-- Scrollable body: protects against small screens / large font scale -->
        <ScrollView
            android:id="@+id/scrollBody"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/dotsContainer"
            app:layout_constraintBottom_toTopOf="@id/actionArea"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/onboarding_horizontal_margin"
                android:paddingEnd="@dimen/onboarding_horizontal_margin"
                android:paddingTop="24dp">

                <FrameLayout
                    android:id="@+id/iconCircle"
                    android:layout_width="@dimen/onboarding_icon_size"
                    android:layout_height="@dimen/onboarding_icon_size"
                    android:background="@drawable/bg_circle">

                    <ImageView
                        android:id="@+id/iconGlyph"
                        android:layout_width="@dimen/dp_36"
                        android:layout_height="@dimen/dp_36"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        tools:src="@drawable/ic_location" />
                </FrameLayout>

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/onboarding_title_size"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    tools:text="See your route in real time" />

                <TextView
                    android:id="@+id/bodyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/onboarding_body_size"
                    android:lineSpacingMultiplier="1.4"
                    tools:text="We use your location while you are using the app to show your position on the map." />

                <!-- Summary list, hidden until the final step -->
                <LinearLayout
                    android:id="@+id/summaryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/dp_20"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>
        </ScrollView>

        <!-- Fixed bottom action area -->
        <LinearLayout
            android:id="@+id/actionArea"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/onboarding_horizontal_margin"
            android:paddingEnd="@dimen/onboarding_horizontal_margin"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/noteText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/onboarding_note_size"
                android:layout_marginBottom="12dp"
                android:visibility="gone"
                tools:text="You can turn this off anytime in Settings." />

            <Button
                android:id="@+id/primaryButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/onboarding_button_height"
                android:text="Continue"
                android:textSize="@dimen/onboarding_body_size"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/skipButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not now"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>