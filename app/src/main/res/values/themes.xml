<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.EcospherePartner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_primary</item>


        <!-- Force light mode -->
        <item name="android:statusBarColor">@color/color_primary
        </item> <!-- or your custom color -->
        <item name="android:navigationBarColor">@color/white</item> <!-- optional -->
        <!-- For status bar icon visibility (works with API 23+) -->
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.EcospherePartner" parent="Base.Theme.EcospherePartner" />

    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/color_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@color/color_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.EcospherePartner</item>
    </style>


    <style name="AppCompatAlertDialogStyleBig" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowAnimationStyle">@style/AnimationDialogWindow</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.8</item>
    </style>
    <style name="AnimationDialogWindow">
        <item name="android:windowEnterAnimation">@anim/dialog_in</item>
        <item name="android:windowExitAnimation">@anim/dialog_out</item>
    </style>

</resources>