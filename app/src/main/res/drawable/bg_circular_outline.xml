<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight"> <!-- Ripple overlay color -->

    <!-- Ripple mask (defines ripple shape) -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_300sdp" />
            <solid android:color="@android:color/white" />
        </shape>
    </item>

    <!-- Normal background (only outline) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" /> <!-- Transparent fill -->
            <stroke
                android:width="1dp"
                android:color="@color/color_icon" /> <!-- Border -->
            <corners android:radius="@dimen/_300sdp" />
        </shape>
    </item>

</ripple>
